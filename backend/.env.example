# Copy this file to .env and fill in real values

SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./insightforge.db

# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# openai/gpt-oss-120b is Groq's current recommended general-purpose model.
# (llama-3.3-70b-versatile, originally used, was deprecated by Groq in 2026.)
GROQ_MODEL=openai/gpt-oss-120b

# AI Insights (Workspace → "AI Insights" tab) uses the same Groq API key
# above but its own model/token budget, kept separate from GROQ_MODEL /
# GROQ_MAX_TOKENS so it can never change the chat assistant's behavior.
GROQ_INSIGHTS_MODEL=openai/gpt-oss-20b
GROQ_INSIGHTS_TEMPERATURE=0.2
GROQ_INSIGHTS_MAX_TOKENS=12000
